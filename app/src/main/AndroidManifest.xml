<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "All files access": move new photos out of Camera etc. into PhotoGate without a prompt per photo.
         Granted by the user in system settings. Fine for a sideloaded app; Play Store would need a review. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ hides other apps unless declared: needed for the "Open" gallery button -->
    <queries>
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.google.android.apps.photos" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PhotoGate">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />
    </application>
</manifest>
